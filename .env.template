# NGINX -- puertos y rutas fijas de la imagen/mecanismo, compartidos por TODOS los proyectos.
NGINX_PORT_HOST=80
NGINX_PORT_CONTAINER=80
NGINX_PORT_MAP=${NGINX_PORT_HOST}:${NGINX_PORT_CONTAINER}
NGINX_PORT_SSL_HOST=443
NGINX_PORT_SSL_CONTAINER=443
NGINX_PORT_SSL_MAP=${NGINX_PORT_SSL_HOST}:${NGINX_PORT_SSL_CONTAINER}
# Fijo -- la imagen oficial de nginx solo procesa (envsubst) archivos .template montados
# exactamente en /etc/nginx/templates, no es una ruta personalizable.
NGINX_VOLUME_TEMPLATES=/etc/nginx/templates
# Monta access.log/error.log al host (./resources/logs) -- sin esto, Fail2Ban (corre en el HOST,
# nunca dentro de un contenedor) no puede leerlos.
NGINX_VOLUME_LOGS=/var/log/nginx

# ---------------------------------------------------------------------------------------------
# OJO orden: "env_file:" (docker-compose.yml) resuelve "${VAR}" linea por linea, secuencial -- a
# diferencia de "environment:" (arma una tabla completa antes de sustituir), una referencia hacia
# una variable definida MAS ABAJO en este archivo queda vacia EN SILENCIO (sin ningun error --
# "nginx: cannot load certificate ...ssl//archivo.cer", con un doble "/", es la pista real de este
# bug). Si agregas una variable base compartida (ej. "APP_CERT_FOLDER" reutilizada por varios
# bloques), definila ANTES de cualquier otra variable que la referencie.
#
# Un bloque por proyecto -- <SITIO> en mayusculas sin separadores (ej. "parser-md" -> "PARSERMD").
# Ningun campo asume un stack en particular: CONTAINER_NAME/PORT_CONTAINER son solo "a donde
# reenviar" -- le da igual si atras hay Angular SSR, Kestrel (.NET), Spring Boot (Java) o un sitio
# estatico. Duplica este bloque completo por cada proyecto nuevo, y agrega su
# resources/templates/<algo>.conf.template correspondiente (ver docs/example-site.conf.template
# para la plantilla comentada).
#
# _SLUG deriva el nombre real del contenedor -- debe coincidir EXACTO con "container_name" en el
# docker-compose.yml del proyecto (asi nginx lo resuelve por DNS en la red "edge-net" compartida).
# _VOLUME_SSL apunta a la carpeta real dentro de resources/ssl/ que trae el certificado de ESE
# dominio -- dos proyectos en el mismo dominio (o subdominios del mismo wildcard) comparten la
# misma carpeta; un proyecto en un dominio distinto usa su propia carpeta.
#
# Ejemplo 1 -- sitio Angular:
# APP_PARSERMD_SLUG=parser-md
# APP_PARSERMD_SERVER_NAME=parser-md.frugocorp.com
# APP_PARSERMD_CONTAINER_NAME=${APP_PARSERMD_SLUG}-app-web
# APP_PARSERMD_PORT_CONTAINER=4000
# APP_PARSERMD_VOLUME_SSL=/etc/resources/ssl/FrugoCorp
# APP_PARSERMD_SSL_CERTIFICATE=frugocorp.com_ssl_certificate.cer
# APP_PARSERMD_SSL_CERTIFICATE_KEY=_.frugocorp.com_private_key.key
# APP_PARSERMD_SSL_TRUSTED_CHAIN_INTERMEDIATE=_.frugocorp.com_ssl_TRUSTED_CHAIN_INTERMEDIATE.cer
#
# Ejemplo 2 -- API de otro stack/dominio, sin relacion con el proyecto de arriba (demuestra que
# nginx-server-docker no le importa el stack ni el dominio: cada bloque es independiente):
# APP_MIAPI_SLUG=mi-api
# APP_MIAPI_SERVER_NAME=api.otrodominio.com
# APP_MIAPI_CONTAINER_NAME=${APP_MIAPI_SLUG}-app
# APP_MIAPI_PORT_CONTAINER=8080
# APP_MIAPI_VOLUME_SSL=/etc/resources/ssl/live/api.otrodominio.com
# APP_MIAPI_SSL_CERTIFICATE=fullchain.pem
# APP_MIAPI_SSL_CERTIFICATE_KEY=privkey.pem
# APP_MIAPI_SSL_TRUSTED_CHAIN_INTERMEDIATE=chain.pem

# ---------------------------------------------------------------------------------------------
# Let's Encrypt automatico (dns-01 contra IONOS) -- servicio "certbot". "letsencrypt" lo levanta,
# vacio/sin definir lo deja apagado (certificado 100% manual, el default).
COMPOSE_PROFILES=
# Dominio raiz a emitir -- certbot pide ademas "*.${LETSENCRYPT_DOMAIN}" a mano en el comando de
# emision inicial, no se arma solo desde esta variable. certbot escribe en
# resources/ssl/live/${LETSENCRYPT_DOMAIN}/ automaticamente (estructura propia de certbot, no
# configurable) -- referencia esa ruta en el bloque APP_<SITIO>_* del proyecto que la use.
LETSENCRYPT_DOMAIN=
# Correo para tu cuenta de Let's Encrypt (avisos de expiracion, no vinculado a IONOS).
LETSENCRYPT_EMAIL=
